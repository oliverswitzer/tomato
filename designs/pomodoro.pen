                  "alignItems": "center",
                  "children": [
                    {
                      "type": "text",
                      "id": "21UhS",
                      "name": "eyebrow",
                      "fill": "#D85440",
                      "content": "WHY BLOCKERS DON'T WORK",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "600",
                      "letterSpacing": 2.4
                    },
                    {
                      "type": "text",
                      "id": "X0lr8",
                      "name": "headline",
                      "fill": "#2B2620",
                      "textGrowth": "fixed-width",
                      "width": 880,
                      "content": "App blockers can't tell research from procrastination.",
                      "lineHeight": 1.1,
                      "textAlign": "center",
                      "fontFamily": "Fraunces",
                      "fontSize": 60,
                      "fontWeight": "600"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "juODk",
                  "name": "subhead",
                  "fill": "#6F665B",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "You're debugging your code on Reddit. You're watching a YouTube tutorial. A dumb URL blocker doesn't care — it shames you for both. That's not focus. That's friction. Tomato understands what you actually set out to do, and only steps in when you've truly drifted.",
                  "lineHeight": 1.5,
                  "textAlign": "center",
                  "fontFamily": "Inter",
                  "fontSize": 19,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "shCGP",
                  "name": "pillRow",
                  "gap": 12,
                  "children": [
                    {
                      "type": "frame",
