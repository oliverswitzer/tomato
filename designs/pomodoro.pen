                  "name": "headline",
                  "fill": "#FAF4E8",
                  "textGrowth": "fixed-width",
                  "width": 1080,
                  "content": "Drift is not failure.\nDrift is evidence.",
                  "lineHeight": 1.05,
                  "textAlign": "center",
                  "fontFamily": "Fraunces",
                  "fontSize": 68,
                  "fontWeight": "600"
                },
                {
                  "type": "text",
                  "id": "K4eikK",
                  "name": "body",
                  "fill": "#C9BFB1",
                  "textGrowth": "fixed-width",
                  "width": 720,
                  "content": "When you leave the work, something caused it. You may be stuck, tired, uncertain, bored, discouraged, or reaching for a cleaner problem. Tomato does not need to shame that moment. It needs to catch it clearly enough for you to make a choice.",
                  "lineHeight": 1.6,
                  "textAlign": "center",
                  "fontFamily": "Inter",
                  "fontSize": 19,
                  "fontWeight": "normal"
                }
              ]
