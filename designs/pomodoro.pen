          },
          "layout": "vertical",
          "gap": 18,
          "padding": 32,
          "children": [
            {
              "type": "text",
              "id": "XuIi3",
              "fill": "#8B8477",
              "content": "INSPIRATION — WHY THIS DESIGN",
              "fontFamily": "Geist Mono",
              "fontSize": 10,
              "fontWeight": "600",
              "letterSpacing": 1.5
            },
            {
              "type": "text",
              "id": "onqec",
              "fill": "#1A1A1A",
              "content": "The journalist's lede",
              "fontFamily": "Newsreader",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "OmqCI",
              "fill": "#5E5A52",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Strong ledes share three traits: active verb, concrete object, implicit time-bound. \"Reply to 5 outstanding leads\" beats \"do email\" the way a sharp lede beats a vague nut graf. The 12-word constraint isn't arbitrary — it forces specificity.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "y4egk6",
              "fill": "#1A1A1A",
              "content": "Letterpress · the act of filing",
              "fontFamily": "Newsreader",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "Cif56",
              "fill": "#5E5A52",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The submit button isn't \"Start.\" It's \"File\" — the word a typesetter uses when committing a piece to the day's edition. Black ink on cream paper. The act is small, ceremonial, committal.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "j2ZOa",
              "fill": "#1A1A1A",
              "content": "The ruled line, not the field",
              "fontFamily": "Newsreader",
              "fontSize": 20,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "TrdUJ",
              "fill": "#5E5A52",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "No box around the input — just a line, like a lined notebook. Negative space carries the weight. The page isn't asking for a form; it's offering you a line.",
              "lineHeight": 1.6,
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "normal"
            },
            {
              "type": "rectangle",
              "id": "xdXn7",
              "fill": "#E2D8C2",
              "width": "fill_container",
              "height": 1
            },
            {
              "type": "text",
              "id": "zG1xk",
              "fill": "#8B8477",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Touchstones: Strunk & White's specificity rule, AP / WSJ lede style guides, Muji notebook typography, the Bullet Journal's intention page.",
              "lineHeight": 1.5,
              "fontFamily": "Inter",
              "fontSize": 11,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
        }
      ]
    },
