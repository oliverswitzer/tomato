        },
        {
          "type": "frame",
          "id": "SWDwA",
          "name": "section/computer",
          "width": "fill_container",
          "fill": "#FFFBF1",
          "layout": "vertical",
          "gap": 32,
          "padding": [
            88,
            96
          ],
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "EONZq",
              "fill": "#D85440",
              "content": "THE MACHINE PROBLEM",
              "fontFamily": "Inter",
              "fontSize": 13,
              "fontWeight": "600",
              "letterSpacing": 2.4
            },
            {
              "type": "text",
              "id": "bwqeP",
              "fill": "#2B2620",
              "textGrowth": "fixed-width",
              "width": 960,
              "content": "Your computer is not built to protect your intention.",
              "lineHeight": 1.05,
              "textAlign": "center",
              "fontFamily": "Fraunces",
              "fontSize": 60,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "ss2kT",
              "fill": "#6F665B",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Your machine contains your editor, browser, inbox, AI tools, messages, feeds, and every possible escape hatch. Most of those tools can be useful or destructive depending on what you meant to do. Reddit can be research or avoidance. Claude can help you ship or help you spiral. Your inbox can be customer work or a hiding place.",
              "lineHeight": 1.55,
              "textAlign": "center",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "normal"
            },
