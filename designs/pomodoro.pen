              ]
            },
            {
              "type": "text",
              "id": "X7ngdh",
              "fill": "#2B2620",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "Tomato starts by asking what this session is for. During that session only, it pays attention locally to what is happening on your screen and looks for signs that your work has drifted from the thing you chose.",
              "lineHeight": 1.55,
              "textAlign": "center",
              "fontFamily": "Inter",
              "fontSize": 19,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "BiOZK",
              "fill": "#6F665B",
              "textGrowth": "fixed-width",
              "width": 720,
              "content": "It does not exist to punish you. It exists to make the drift visible while there is still time to recover.",
              "textAlign": "center",
              "fontFamily": "Fraunces",
              "fontSize": 22,
              "fontWeight": "normal",
              "fontStyle": "italic"
            }
          ]
        },
        {
          "type": "frame",
