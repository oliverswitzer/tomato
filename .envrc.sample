# Tomato App (required)
export ANTHROPIC_API_KEY=""

# Tomato App (optional)
# export SCREENPIPE_BIN=""       # Override path to screenpipe binary (default: searches /opt/homebrew/bin, /usr/local/bin)
# export TOMATO_BATCH_MS=""      # How often (ms) to batch screen activity for LLM focus analysis. Lower = more responsive but more API calls

# Agent Orchestrator (required)
export LINEAR_API_KEY=""

# Agent Orchestrator (optional)
# export DISCORD_WEBHOOK_URL=""  # Discord webhook for agent notifications
# export SLACK_WEBHOOK_URL=""    # Slack webhook for agent notifications
