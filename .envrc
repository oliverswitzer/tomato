# Path to the patched screenpipe binary (PR #3073).
# Required for npm run pack to bundle screenpipe into the app.
export SCREENPIPE_BIN="$HOME/workspace/screenpipe/target/release/screenpipe"

# How often (ms) to batch screen activity for LLM summarization.
export TOMATO_BATCH_MS="15000"

# Secrets and machine-specific overrides live in .local/envrc (gitignored).
# Copy .local/envrc.sample to .local/envrc and fill in your values.
source_env_if_exists .local/envrc
