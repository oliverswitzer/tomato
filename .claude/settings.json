{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/metadata-updater.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(ao spawn*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/linear-status-hook.sh",
            "timeout": 10000,
            "statusMessage": "Updating Linear status..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(gh pr merge*)",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/linear-status-hook.sh",
            "timeout": 10000,
            "statusMessage": "Updating Linear status..."
          }
        ]
      }
    ]
  }
}
